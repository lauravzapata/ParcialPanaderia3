<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="480.0" prefWidth="760.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.panaderia.viewcontrollers.EmpleadoViewController">
    <children>
        <Text fill="#8a4b08" layoutX="20.0" layoutY="40.0" text="Registro de empleados">
            <font><Font name="System Bold" size="22.0" /></font>
        </Text>

        <Label layoutX="20.0" layoutY="70.0" text="Tipo (ARTESANAL, INDUSTRIAL o CAJERO)" />
        <TextField fx:id="txtTipo" layoutX="20.0" layoutY="90.0" prefWidth="220.0" />
        <Label layoutX="260.0" layoutY="70.0" text="Nombre" />
        <TextField fx:id="txtNombre" layoutX="260.0" layoutY="90.0" prefWidth="220.0" />
        <Label layoutX="500.0" layoutY="70.0" text="Documento" />
        <TextField fx:id="txtDocumento" layoutX="500.0" layoutY="90.0" prefWidth="220.0" />

        <Label layoutX="20.0" layoutY="130.0" text="Codigo" />
        <TextField fx:id="txtCodigo" layoutX="20.0" layoutY="150.0" prefWidth="220.0" />
        <Label layoutX="260.0" layoutY="130.0" text="Minutos disponibles" />
        <TextField fx:id="txtMinutos" layoutX="260.0" layoutY="150.0" prefWidth="220.0" />
        <Label layoutX="500.0" layoutY="130.0" text="Caja (solo cajeros)" />
        <TextField fx:id="txtCaja" layoutX="500.0" layoutY="150.0" prefWidth="220.0" />

        <Button layoutX="20.0" layoutY="195.0" mnemonicParsing="false" onAction="#registrarEmpleadoEvent" prefWidth="220.0" text="Registrar empleado" />
        <Button layoutX="620.0" layoutY="195.0" mnemonicParsing="false" onAction="#volverEvent" prefWidth="100.0" text="Volver" />

        <Label layoutX="20.0" layoutY="240.0" text="Empleados registrados (en orden de registro)">
            <font><Font name="System Bold" size="14.0" /></font>
        </Label>
        <Label fx:id="lblEmpleados" alignment="TOP_LEFT" layoutX="20.0" layoutY="265.0" prefHeight="200.0" prefWidth="720.0" />
    </children>
</AnchorPane>
