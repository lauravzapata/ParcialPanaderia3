<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.panaderia.viewcontrollers.PedidoViewController">
    <children>
        <Text fill="#8a4b08" layoutX="20.0" layoutY="40.0" text="Gestion de pedidos">
            <font><Font name="System Bold" size="22.0" /></font>
        </Text>

        <Label layoutX="20.0" layoutY="70.0" text="Codigo" />
        <TextField fx:id="txtCodigo" layoutX="20.0" layoutY="90.0" prefWidth="150.0" promptText="P01" />
        <Label layoutX="190.0" layoutY="70.0" text="Cliente" />
        <TextField fx:id="txtCliente" layoutX="190.0" layoutY="90.0" prefWidth="250.0" />
        <Label layoutX="460.0" layoutY="70.0" text="Tipo de pan (TRADICIONAL o INTEGRAL)" />
        <TextField fx:id="txtTipoPan" layoutX="460.0" layoutY="90.0" prefWidth="220.0" />
        <Label layoutX="700.0" layoutY="70.0" text="Cantidad" />
        <TextField fx:id="txtCantidad" layoutX="700.0" layoutY="90.0" prefWidth="120.0" />

        <Button layoutX="20.0" layoutY="135.0" mnemonicParsing="false" onAction="#registrarPedidoEvent" prefWidth="170.0" text="Registrar pedido" />
        <Button layoutX="205.0" layoutY="135.0" mnemonicParsing="false" onAction="#asignarPedidoEvent" prefWidth="170.0" text="Asignar a produccion" />
        <Button layoutX="390.0" layoutY="135.0" mnemonicParsing="false" onAction="#cancelarPedidoEvent" prefWidth="170.0" text="Cancelar pedido" />
        <Button layoutX="780.0" layoutY="135.0" mnemonicParsing="false" onAction="#volverEvent" prefWidth="100.0" text="Volver" />
        <Label layoutX="20.0" layoutY="168.0" text="Para asignar o cancelar escriba el codigo del pedido." textFill="#6b6b6b" />

        <Label layoutX="20.0" layoutY="200.0" text="Historial de pedidos">
            <font><Font name="System Bold" size="14.0" /></font>
        </Label>
        <Label fx:id="lblPedidos" alignment="TOP_LEFT" layoutX="20.0" layoutY="225.0" prefHeight="170.0" prefWidth="860.0" />

        <Label layoutX="20.0" layoutY="410.0" text="Disponibilidad de empleados">
            <font><Font name="System Bold" size="14.0" /></font>
        </Label>
        <Label fx:id="lblEmpleados" alignment="TOP_LEFT" layoutX="20.0" layoutY="435.0" prefHeight="150.0" prefWidth="860.0" />
    </children>
</AnchorPane>
