package co.edu.uniquindio.poo.panaderia.app;

import co.edu.uniquindio.poo.panaderia.model.Cajero;
import co.edu.uniquindio.poo.panaderia.model.Panaderia;
import co.edu.uniquindio.poo.panaderia.model.PanaderoArtesanal;
import co.edu.uniquindio.poo.panaderia.model.PanaderoIndustrial;
import co.edu.uniquindio.poo.panaderia.model.TipoPan;
import co.edu.uniquindio.poo.panaderia.viewcontrollers.EmpleadoViewController;
import co.edu.uniquindio.poo.panaderia.viewcontrollers.InicioViewController;
import co.edu.uniquindio.poo.panaderia.viewcontrollers.PedidoViewController;
import javafx.application.Application;
import javafx.fxml.FXMLLoader;
import javafx.scene.Scene;
import javafx.scene.layout.AnchorPane;
import javafx.stage.Stage;

import java.io.IOException;

public class Aplicacion extends Application {

    private Stage primaryStage;
    
    public static Panaderia panaderia = new Panaderia("El Trigal");

    @Override
    public void start(Stage primaryStage) throws IOException {
        this.primaryStage = primaryStage;
        this.primaryStage.setTitle("Panaderia El Trigal");
        inicializarData();
        openViewInicio();
    }


    public void openViewInicio() {
        try {
            FXMLLoader loader = new FXMLLoader();
            loader.setLocation(Aplicacion.class.getResource("/co/edu/uniquindio/poo/panaderia/inicio.fxml"));
            AnchorPane rootLayout = (AnchorPane) loader.load();
            InicioViewController inicioViewController = loader.getController();
            inicioViewController.setApp(this);

            Scene scene = new Scene(rootLayout);
            primaryStage.setScene(scene);
            primaryStage.show();
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    public void openViewEmpleados() {
        try {
            FXMLLoader loader = new FXMLLoader();
            loader.setLocation(Aplicacion.class.getResource("/co/edu/uniquindio/poo/panaderia/empleados.fxml"));
            AnchorPane rootLayout = (AnchorPane) loader.load();
            EmpleadoViewController empleadoViewController = loader.getController();
            empleadoViewController.setApp(this);

            Scene scene = new Scene(rootLayout);
            primaryStage.setScene(scene);
            primaryStage.show();
        } catch (IOException e) {
            e.printStackTrace();
        }
    }


    public void openViewPedidos() {
        try {
            FXMLLoader loader = new FXMLLoader();
            loader.setLocation(Aplicacion.class.getResource("/co/edu/uniquindio/poo/panaderia/pedidos.fxml"));
            AnchorPane rootLayout = (AnchorPane) loader.load();
            PedidoViewController pedidoViewController = loader.getController();
            pedidoViewController.setApp(this);

            Scene scene = new Scene(rootLayout);
            primaryStage.setScene(scene);
            primaryStage.show();
        } catch (IOException e) {
            e.printStackTrace();
        }
    }

    private void inicializarData() {
        Aplicacion.panaderia.registrarEmpleado(new PanaderoArtesanal("Ana", "1001", "E01", 100));
        Aplicacion.panaderia.registrarEmpleado(new PanaderoIndustrial("Carlos", "1002", "E02", 120));
        Aplicacion.panaderia.registrarEmpleado(new PanaderoArtesanal("Diana", "1003", "E03", 80));
        Aplicacion.panaderia.registrarEmpleado(new Cajero("Lucia", "1004", "E04", 120, "Caja 1"));

        Aplicacion.panaderia.registrarPedido("P01", "Cafeteria Central", TipoPan.TRADICIONAL, 25);
        Aplicacion.panaderia.registrarPedido("P02", "Restaurante Sur", TipoPan.INTEGRAL, 13);
    }

    public static void main(String[] args) {
        launch();
    }
}
