<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="320.0" prefWidth="420.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.panaderia.viewcontrollers.InicioViewController">
    <children>
        <Text fill="#8a4b08" layoutX="70.0" layoutY="55.0" text="Panaderia El Trigal">
            <font><Font name="System Bold" size="28.0" /></font>
        </Text>
        <Text fill="#5c3a12" layoutX="105.0" layoutY="85.0" text="Gestion de pedidos y produccion">
            <font><Font size="14.0" /></font>
        </Text>
        <Separator layoutX="40.0" layoutY="100.0" prefWidth="340.0" />
        <Button layoutX="110.0" layoutY="135.0" mnemonicParsing="false" onAction="#abrirEmpleadosEvent" prefHeight="45.0" prefWidth="200.0" text="Empleados">
            <font><Font name="System Bold" size="16.0" /></font>
        </Button>
        <Button layoutX="110.0" layoutY="205.0" mnemonicParsing="false" onAction="#abrirPedidosEvent" prefHeight="45.0" prefWidth="200.0" text="Pedidos">
            <font><Font name="System Bold" size="16.0" /></font>
        </Button>
    </children>
</AnchorPa
